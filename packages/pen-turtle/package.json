{
  "name": "@mitchallen/pen-turtle",
  "version": "0.33.3",
  "description": "Turtle based vector path generator",
  "keywords": [
    "turtle",
    "pen",
    "logo",
    "svg",
    "canvas"
  ],
  "author": "Mitch Allen <github@mitchallen.com>",
  "homepage": "https://github.com/mitchallen/drawing-kit/tree/main/packages/pen-turtle#readme",
  "publishConfig": {
