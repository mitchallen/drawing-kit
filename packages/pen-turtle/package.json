  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitchallen/drawing-kit.git"
  },
  "scripts": {
    "//": "npm run doc -ws --if-present",
    "doc": "npx jsdoc2md lib/*.js > PEN-TURTLE-DOC.md",
