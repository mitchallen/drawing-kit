node_modules/
lerna-debug.log
npm-debug.log
.DS_Store
# Generated test output. The suites rewrite these on every run (several are
# randomized), so tracking them produces churn. placeholder.txt is kept so the
# directory still exists in a fresh clone for the tests to write into.
**/__tests__/output/*
!**/__tests__/output/placeholder.txt
coverage/

# The examples install the published packages from GitHub Packages and are
# not workspaces. A committed lockfile freezes an old release (tile-101 kept
# svg-tile 0.12.4 and its undici alerts after 0.12.5 dropped cheerio), and
# nothing updates it, so let `npm install` resolve the current versions.
examples/**/package-lock.json
